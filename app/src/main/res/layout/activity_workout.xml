<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".WorkoutActivity">

    <TextView
        android:id="@+id/tvWorkoutTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/workout_title"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/lblSelectPlan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_select_plan"
        app:layout_constraintTop_toBottomOf="@id/tvWorkoutTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <Spinner
        android:id="@+id/spinnerPlan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/lblSelectPlan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/lblSelectUebung"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_select_uebung"
        app:layout_constraintTop_toBottomOf="@id/spinnerPlan"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <Spinner
        android:id="@+id/spinnerUebung"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/lblSelectUebung"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/etGewicht"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_gewicht"
        android:inputType="numberDecimal"
        app:layout_constraintTop_toBottomOf="@id/spinnerUebung"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <EditText
        android:id="@+id/etWiederholungen"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_wiederholungen"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/etGewicht"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/etSaetze"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/hint_saetze"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/etWiederholungen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnTrainingSpeichern"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_training_speichern"
        app:layout_constraintTop_toBottomOf="@id/etSaetze"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>